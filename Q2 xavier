# Basic operations

def flatten_vector_field(field):
    field_transpose = np.transpose(field, axes=(1, 0, 2))
    flat_field = field_transpose.reshape(-1,2)

    return flat_field

def unflatten_vector_field(flat_field):

    flat_x = flat_field[:,0]
    flat_y = flat_field[:,1]
    field_x = flat_x.reshape((Nodes_y,Nodes_x))
    field_y = flat_y.reshape((Nodes_y,Nodes_x))

    field = np.stack((field_x, field_y), axis=-1)  # Shape: (3, 9, 2)
    
    return field
    
def central_diff_x(scalar_field): # both the right and left ahnd side are 0
    f = scalar_field
    diff = np.zeros_like(f)
    for j in range (Nodes_y):
        for i in range (1, Nodes_x-1):
            diff[j,i] = (f[j,i+1]-f[j,i-1])/(2*h)
    return diff





def central_diff_y(scalar_field):
    f = scalar_field

    diff = np.zeros_like(f)
    for j in range (Nodes_y):
        for i in range (Nodes_x):
            if j == 0 :
                diff[0,i] = (f[1,i]-f[N_y-1,i])/(2*h)
            elif j == (Nodes_y-1) :
                diff[N_y,i] = (f[1,i]-f[N_y-1,i])/(2*h)
            else :
                diff[j,i] = (f[j+1,i]-f[j-1,i])/(2*h)
            
    return(diff)

def form_c_field_x(scalar_field_x, scalar_field_y, D1_field_x, D2_field_x):

    D1_x = D1_field_x
    D2_x = D2_field_x
    u = scalar_field_x
    v = scalar_field_y

    c_field_x = np.zeros_like(scalar_field_x)

    for j in range (Nodes_y):
        
        for i in range (1, (Nodes_x - 1)):
            c_field_x[j,i] += (((u[j,i])/timestep) - (D1_x[j,i] * u[j,i] + D2_x[j,i] * v[j,i]))

    c_field_x[:,0] = U_infinity[0]
    c_field_x[:,Nodes_x-1] = U_infinity[0]

    return c_field_x

def form_c_field_y(scalar_field_x, scalar_field_y, D1_field_y, D2_field_y):

    D1_y = D1_field_y
    D2_y = D2_field_y
    u = scalar_field_x
    v = scalar_field_y

    c_field_y = np.zeros_like(scalar_field_x)

    for j in range (Nodes_y):
        for i in range (1, (Nodes_x-1)):
            c_field_y[j,i] = (((v[j,i])/timestep) - (D1_y[j,i] * u[j,i] + D2_y[j,i] * v[j,i]))

    c_field_y[:,0] = U_infinity[1]
    c_field_y[:,Nodes_x-1] = U_infinity[1]

    return c_field_y

def laplace(f):
    diff = np.zeros_like(f)
    for j in range (1,N_y):
        for i in range (1, N_x):
            diff[j,i] = (f[j,i+1]+f[j,i-1]+f[j+1,i]+f[j-1,i]-4*f[j,i])/(h**2)
            
            #periodic BCs
            diff[0,i] = (f[0,i+1]+f[0,i-1]+f[1,i]+f[N_y-1,i]-4*f[0,i])/(h**2)
            diff[N_y,i] = (f[N_y,i+1]+f[N_y,i-1]+f[1,i]+f[N_y-1,i]-4*f[N_y,i])/(h**2)
 
    return(diff)





