b_entry = - VISCOSITY/(h**2)

def d_fct(x, y):
    return np.sqrt((x-x_c)**2+(y-y_c)**2)-R

def chi_fct(x, y):
    dist = d_fct(x, y)
    if dist <= -epsilon:
        return 1
    elif dist >= epsilon:
        return 0
    else:
        return 1/(1+np.e**((-4*dist*epsilon)/(dist**2-epsilon**2)))
 
def a_fct(x, y):
    chi = chi_fct(x,y)
    a_entry = (1 / timestep
         + chi / PENALIZATION
         + 4 * VISCOSITY / (h**2))
    return a_entry

